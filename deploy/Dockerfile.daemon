# Multi-stage minimal container for HUNTX Proxy Daemon & PAC Server
# Authority: OCI Image Format Specification
FROM golang:1.26.11-alpine3.24@sha256:ae52b5bc6ed045a9ed26ab03dc19327a802a9cc9aa8b27ed57f5c6b60579b0bb AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/huntx-daemon/ ./cmd/huntx-daemon/
RUN CGO_ENABLED=0 GOOS=linux go build -mod=readonly -ldflags="-s -w" -o /huntx-daemon ./cmd/huntx-daemon

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN adduser -D -u 10001 huntx
USER 10001
COPY --from=builder /huntx-daemon /usr/local/bin/huntx-daemon
EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/huntx-daemon"]

# Multi-stage minimal container for HUNTX Edge Vantage Probe Agent
# Authority: OCI Image Format Specification
FROM golang:1.26.9-alpine3.24@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/huntx-probe/ ./cmd/huntx-probe/
COPY cmd/huntx-engine/ ./cmd/huntx-engine/
RUN CGO_ENABLED=0 GOOS=linux go build -mod=readonly -ldflags="-s -w" -o /huntx-probe ./cmd/huntx-probe

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN adduser -D -u 10001 huntx
USER 10001
COPY --from=builder /huntx-probe /usr/local/bin/huntx-probe
EXPOSE 9091
ENTRYPOINT ["/usr/local/bin/huntx-probe"]

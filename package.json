{
  "name": "huntx-static-dashboard",
  "private": true,
  "scripts": {
    "build:css": "node scripts/build_tailwind_css.mjs",
    "lint": "eslint .",
    "test:unit": "node --experimental-default-type=module --test tests/frontend_runtime.test.mjs tests/frontend_config_injection.test.mjs tests/frontend_evidence_explorer.test.mjs",
    "test:e2e": "playwright test",
    "check:frontend": "npm run lint && npm run test:unit && python scripts/update_frontend.py --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}

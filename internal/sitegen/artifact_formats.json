{
  "schema_version": 1,
  "note": "Single source of truth for artifact classification. The Go site generator (internal/sitegen) embeds this file and the Python dashboard generator (scripts/generate_site_data.py) reads it, so both describe the same filename the same way. Rules are evaluated in order; the first match wins. Precedence is deliberate: client-format node subscriptions must match before generic JSON/YAML metadata, and the order also keeps the .json rule below the profile rules that already matched.",
  "products": {
    "all_sources.txt": [
      "all_sources.txt",
      "all_sources.npvt",
      "all_sources.npvt.raw.txt",
      "all_sources_npvt_raw.txt"
    ],
    "all_sources_base64.txt": [
      "all_sources_base64.txt",
      "all_sources.npvt.b64sub",
      "all_sources_npvt_b64sub.txt"
    ],
    "all_sources.json": [
      "all_sources.json",
      "all_sources_npvt_decoded.json"
    ],
    "all_sources_singbox.json": [
      "all_sources_singbox.json",
      "all_sources_npvt_singbox.json"
    ],
    "all_sources_xray.json": [
      "all_sources_xray.json",
      "all_sources_npvt_xray.json"
    ],
    "all_sources_nekobox.json": [
      "all_sources_nekobox.json",
      "all_sources_npvt_nekobox.json"
    ],
    "all_sources_clash.yaml": [
      "all_sources_clash.yaml"
    ],
    "all_sources_singbox_profile.json": [
      "all_sources_singbox_profile.json"
    ],
    "all_sources_xray_profile.json": [
      "all_sources_xray_profile.json"
    ]
  },
  "sections": {
    "release": {
      "base_tags": [
        "release",
        "production"
      ],
      "default_description": "Verified artifact from the latest published run",
      "rules": [
        {
          "match": {
            "kind": "contains",
            "value": "singbox_profile"
          },
          "type": "SINGBOX",
          "tags": [
            "client-config",
            "singbox",
            "full-config"
          ],
          "description": "Complete runnable Sing-box client profile with inbound, DNS, routing and selector policy. Download/import as a full configuration; it is separate from the independent-node Sing-box subscription URL."
        },
        {
          "match": {
            "kind": "contains",
            "value": "singbox"
          },
          "type": "SINGBOX",
          "tags": [
            "subscription",
            "singbox",
            "json-nodes",
            "multi-node"
          ],
          "description": "Sing-box JSON multi-node subscription. The payload contains standalone proxy outbounds only and deliberately omits inbound/DNS/route profile policy so compatible subscription updaters expand nodes independently."
        },
        {
          "match": {
            "kind": "contains",
            "value": "xray_profile"
          },
          "type": "XRAY",
          "tags": [
            "client-config",
            "xray",
            "full-config"
          ],
          "description": "Complete runnable Xray client profile with local inbound and full configuration envelope. Download/import as a full configuration; it is separate from the outbounds-only Xray subscription URL."
        },
        {
          "match": {
            "kind": "contains_any",
            "value": [
              "v2ray",
              "xray"
            ]
          },
          "type": "XRAY",
          "tags": [
            "subscription",
            "xray",
            "v2ray",
            "json-nodes",
            "multi-node"
          ],
          "description": "Xray/V2Ray JSON multi-node subscription. The payload is outbounds-only, so compatible subscription updaters such as v2rayN import each outbound as an independent subscription item."
        },
        {
          "match": {
            "kind": "equals",
            "value": "manifest.json"
          },
          "type": "MANIFEST",
          "tags": [
            "manifest",
            "checksums",
            "release-gate"
          ],
          "description": "Release manifest: per-artifact size and SHA-256 checksum index"
        },
        {
          "match": {
            "kind": "equals",
            "value": ".huntx-output-ownership.json"
          },
          "type": "OWNERSHIP",
          "tags": [
            "ownership",
            "provenance",
            "release-gate"
          ],
          "description": "Per-file ownership map tying each release artifact to its pipeline route"
        },
        {
          "match": {
            "kind": "contains",
            "value": "clash"
          },
          "type": "CLASH",
          "tags": [
            "subscription",
            "clash",
            "mihomo",
            "yaml-nodes",
            "multi-node"
          ],
          "description": "Clash/Mihomo proxy-provider subscription. The payload contains only a proxies list of standalone nodes, so provider refresh updates independent proxy entries without importing routing, DNS, listeners, or proxy groups."
        },
        {
          "match": {
            "kind": "contains",
            "value": "ovpn"
          },
          "type": "OVPN",
          "tags": [
            "openvpn",
            "vpn",
            "gateway"
          ],
          "description": "Standard OpenVPN multi-gateway client profile with TLS auth"
        },
        {
          "match": {
            "kind": "contains_any",
            "value": [
              "base64",
              "b64sub"
            ]
          },
          "type": "B64SUB",
          "tags": [
            "subscription",
            "base64",
            "unified-feed",
            "multi-node"
          ],
          "description": "Base64-encoded multi-node subscription for Shadowrocket, v2rayNG, Streisand, Hiddify and NekoBox. This is the link to add as a subscription URL: the body is one encoded node per line, so it expands into individual nodes."
        },
        {
          "match": {
            "kind": "contains",
            "value": "nekobox"
          },
          "type": "NEKOBOX",
          "tags": [
            "subscription",
            "json-nodes",
            "multi-node"
          ],
          "description": "NekoBox-compatible JSON node feed: a minimal object containing standalone sing-box outbounds and no DNS, route, or inbound policy. Current NekoBox expands those outbounds into independent nodes instead of treating the document as one full custom configuration."
        },
        {
          "match": {
            "kind": "endswith",
            "value": ".json"
          },
          "type": "JSON",
          "tags": [
            "decoded",
            "parameters",
            "metadata"
          ],
          "description": "Parsed and structured proxy connection parameters JSON dataset for inspection. This is a diagnostic dataset, not a client subscription."
        },
        {
          "match": {
            "kind": "endswith",
            "value": ".txt"
          },
          "type": "TXT",
          "tags": [
            "raw-uris",
            "plain-text",
            "multi-node",
            "uri-feed"
          ],
          "description": "Plain-text multi-node proxy URI subscription feed, one node per line. Use the base64 feed in clients that only accept a base64 subscription body."
        },
        {
          "match": {
            "kind": "contains",
            "value": "npvt"
          },
          "type": "NPVT",
          "tags": [
            "subscription",
            "uri-feed"
          ],
          "description": "Frozen compatibility alias of the plain-text proxy URI feed, published under an earlier filename."
        },
        {
          "match": {
            "kind": "contains",
            "value": "opaque_bundle"
          },
          "type": "BUNDLE",
          "tags": [
            "bundle",
            "opaque",
            "encrypted"
          ],
          "description": "ZIP archive of opaque encrypted client config blobs"
        },
        {
          "match": {
            "kind": "endswith",
            "value": ".conf_lines"
          },
          "type": "CONF_LINES",
          "tags": [
            "proxy-lines",
            "deduped"
          ],
          "description": "Deduplicated proxy configuration line list for line-based clients"
        },
        {
          "match": {
            "kind": "endswith",
            "value": ".dark"
          },
          "type": "DARK",
          "tags": [
            "opaque",
            "encrypted",
            "dark-tunnel"
          ],
          "description": "Dark Tunnel VPN encrypted client config (opaque binary bundle)"
        },
        {
          "match": {
            "kind": "endswith",
            "value": ".ehi"
          },
          "type": "EHI",
          "tags": [
            "opaque",
            "encrypted"
          ],
          "description": "Encrypted client config blob shipped as an opaque binary bundle"
        },
        {
          "match": {
            "kind": "endswith",
            "value": ".hc"
          },
          "type": "HC",
          "tags": [
            "opaque",
            "encrypted"
          ],
          "description": "Encrypted client config blob shipped as an opaque binary bundle"
        },
        {
          "match": {
            "kind": "endswith",
            "value": ".sip"
          },
          "type": "SIP",
          "tags": [
            "opaque",
            "encrypted"
          ],
          "description": "Encrypted client config blob shipped as an opaque binary bundle"
        },
        {
          "match": {
            "kind": "endswith",
            "value": ".nm"
          },
          "type": "NM",
          "tags": [
            "opaque",
            "encrypted",
            "netmod"
          ],
          "description": "NetMod encrypted client config with optional decryption enrichment"
        },
        {
          "match": {
            "kind": "endswith",
            "value": ".npv4"
          },
          "type": "NPV4",
          "tags": [
            "opaque",
            "encrypted",
            "napsternetv"
          ],
          "description": "NapsternetV v4 encrypted blob with optional decryption metadata"
        },
        {
          "match": {
            "kind": "endswith",
            "value": ".hat"
          },
          "type": "HAT",
          "tags": [
            "opaque",
            "encrypted",
            "ha-tunnel"
          ],
          "description": "HA Tunnel Plus encrypted blob with optional decryption metadata"
        },
        {
          "match": {
            "kind": "endswith_any",
            "value": [
              ".tut",
              ".sks",
              ".tmt"
            ]
          },
          "type": "from_extension",
          "tags": [
            "opaque",
            "encrypted"
          ],
          "description": "Encrypted client config blob with optional deep-decryption metadata"
        },
        {
          "match": {
            "kind": "endswith",
            "value": ".md"
          },
          "type": "MD",
          "tags": [
            "documentation"
          ],
          "description": "Production release documentation and checksum index"
        }
      ]
    },
    "dev": {
      "base_tags": [
        "dev",
        "cumulative"
      ],
      "default_description": "Development and cumulative output artifact",
      "rules": [
        {
          "match": {
            "kind": "starts_with",
            "value": "proxies_chunk_"
          },
          "type": "CHUNK",
          "tags": [
            "chunk",
            "split-feed",
            "lightweight"
          ],
          "description": "Lightweight split feed chunk ({filename}) for bandwidth-constrained clients"
        },
        {
          "match": {
            "kind": "contains",
            "value": "b64sub"
          },
          "type": "B64SUB",
          "tags": [
            "subscription",
            "base64",
            "all-time"
          ],
          "description": "All-time cumulative Base64 subscription feed across 49+ sources"
        },
        {
          "match": {
            "kind": "equals",
            "value": "proxies.json"
          },
          "type": "JSON",
          "tags": [
            "aggregated",
            "all-time",
            "full-json"
          ],
          "description": "Complete all-time cumulative proxy dataset with first-seen timestamps"
        },
        {
          "match": {
            "kind": "equals",
            "value": "proxies.txt"
          },
          "type": "TXT",
          "tags": [
            "raw-uris",
            "deduped",
            "all-time"
          ],
          "description": "All-time cumulative raw proxy URI list (SHA-256 deduplicated)"
        },
        {
          "match": {
            "kind": "equals",
            "value": "_manifest.json"
          },
          "type": "MANIFEST",
          "tags": [
            "manifest",
            "telemetry",
            "state"
          ],
          "description": "Durable cumulative first-seen timestamp manifest index"
        },
        {
          "match": {
            "kind": "endswith",
            "value": ".md"
          },
          "type": "MD",
          "tags": [
            "documentation"
          ],
          "description": "Development and cumulative output documentation"
        }
      ]
    }
  }
}

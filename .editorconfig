root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.go]
indent_style = tab

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Generated by the pipeline. Left untouched so a formatter never rewrites it.
[docs/assets/js/data.js]
insert_final_newline = unset
trim_trailing_whitespace = unset

[docs/assets/css/tailwind.css]
insert_final_newline = unset
trim_trailing_whitespace = unset
